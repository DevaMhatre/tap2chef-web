# Port and address the Express server listens on. On the VPS: 8100 on
# 127.0.0.1, so only nginx reaches it (8000 is the POS API).
PORT=8000
HOST=

# MongoDB connection string
MONGO_URL=mongodb://127.0.0.1:27017/tap2chef

# Secret used to sign/verify JWTs — use a long random string in any real deployment
JWT_SECRET=change-me

# Frontend origin(s) allowed by CORS (comma-separated for multiple)
CLIENT_URL=http://localhost:5173

# "production" on the server: sends real emails and turns on rate limits.
# Anywhere else, sign-in codes are printed to the console.
NODE_ENV=development

# Email for sign-in codes (production only), via resend.com
RESEND_API_KEY=
MAIL_FROM="Tap2Chef <codes@devamhatre.com>"
